{
  "name": "@sinaedle/design-system",
  "version": "1.0.0",
  "type": "module",
  "files": [
    "dist",
    "src/fonts",
    "src/styles"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pretendard.css": "./src/styles/pretendard.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "build:lib": "vite build",
    "build:types": "tsc",
    "build": "npm run build:lib && npm run build:types",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22",
    "pretendard": "^1.3.9",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "license": "MIT"
}
